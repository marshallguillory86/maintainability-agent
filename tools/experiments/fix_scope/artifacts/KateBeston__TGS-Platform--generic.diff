diff --git a/tests/form-values.test.mjs b/tests/form-values.test.mjs
new file mode 100644
index 0000000..dc788fc
--- /dev/null
+++ b/tests/form-values.test.mjs
@@ -0,0 +1,30 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import {
+  formEmail,
+  formText,
+  isValidEmail,
+  optionalFormText,
+  stayLength,
+} from '../lib/form-values.ts';
+
+test('form text normalization handles missing and padded values', () => {
+  assert.equal(formText(undefined), '');
+  assert.equal(formText('  Ada  '), 'Ada');
+  assert.equal(optionalFormText('  '), null);
+  assert.equal(optionalFormText('  hello  '), 'hello');
+});
+
+test('email normalization and validation are separate, reusable rules', () => {
+  assert.equal(formEmail('  ADA@EXAMPLE.COM '), 'ada@example.com');
+  assert.equal(isValidEmail('ada@example.com'), true);
+  assert.equal(isValidEmail('ada@example'), false);
+});
+
+test('stay length accepts valid ranges and rejects unusable dates', () => {
+  assert.equal(stayLength('2026-08-08', '2026-08-11'), 3);
+  assert.equal(stayLength('', '2026-08-11'), null);
+  assert.equal(stayLength('not-a-date', '2026-08-11'), null);
+  assert.equal(stayLength('2026-08-11', '2026-08-08'), null);
+});
