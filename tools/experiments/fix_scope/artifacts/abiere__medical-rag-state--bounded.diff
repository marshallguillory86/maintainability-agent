@@ -0,0 +1,40 @@
+"""Focused tests for book metadata parsing."""
+
+import os
+import sys
+import unittest
+from pathlib import Path
+
+PROJECT_ROOT = Path(__file__).resolve().parents[1]
+os.environ.setdefault("MEDICAL_RAG_BASE", str(PROJECT_ROOT))
+sys.path.insert(0, str(PROJECT_ROOT / "scripts"))
+
+from book_metadata_vision import _parse_isbnsearch_markdown
+
+
+class IsbnsearchMarkdownTests(unittest.TestCase):
+    def test_parses_supported_fields(self):
+        metadata = _parse_isbnsearch_markdown("\n".join([
+            "**Title**: Gray's Anatomy",
+            "Authors: Henry Gray, MD; Susan Standring",
+            "Publisher: Elsevier",
+            "Published: 2020 edition",
+            "ISBN-13: 978-0-443-10028-4",
+            "ISBN-10: 0-443-10028-8",
+        ]))
+        self.assertEqual(metadata["title"], "Gray's Anatomy")
+        self.assertEqual(metadata["authors"], ["Henry Gray", "Susan Standring"])
+        self.assertEqual(metadata["publisher"], "Elsevier")
+        self.assertEqual(metadata["year"], 2020)
+        self.assertEqual(metadata["isbn_13"], "9780443100284")
+        self.assertEqual(metadata["isbn_10"], "0443100288")
+
+    def test_keeps_first_value_and_ignores_noise(self):
+        metadata = _parse_isbnsearch_markdown(
+            "Title: First title\nnot a field\nTitle: Second title\nYear: unknown"
+        )
+        self.assertEqual(metadata, {"title": "First title"})
+
+
+if __name__ == "__main__":
+    unittest.main()
