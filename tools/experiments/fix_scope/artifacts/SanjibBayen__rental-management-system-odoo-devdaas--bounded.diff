diff --git a/services/server/test/rbac.middleware.test.ts b/services/server/test/rbac.middleware.test.ts
new file mode 100644
index 0000000..ee93a71
--- /dev/null
+++ b/services/server/test/rbac.middleware.test.ts
@@ -0,0 +1,60 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import type { NextFunction, Response } from 'express';
+import { authMiddleware as canonicalAuthMiddleware } from '../src/middleware/auth.middleware.js';
+import {
+  authMiddleware,
+  type AuthRequest,
+  rbacMiddleware,
+} from '../src/middleware/rbac.middleware.js';
+
+const user = {
+  id: 'user-1',
+  email: 'admin@example.com',
+  full_name: 'Admin User',
+  role: 'admin' as const,
+  email_verified: true,
+};
+
+test('re-exports the canonical authentication middleware', () => {
+  assert.equal(authMiddleware, canonicalAuthMiddleware);
+});
+
+test('allows an authenticated user with an allowed role', () => {
+  const req = { user } as AuthRequest;
+  const res = {} as Response;
+  let nextCalled = false;
+
+  rbacMiddleware(['admin'])(req, res, (() => {
+    nextCalled = true;
+  }) as NextFunction);
+
+  assert.equal(nextCalled, true);
+});
+
+test('rejects a missing or disallowed role', () => {
+  for (const req of [{}, { user: { ...user, role: 'customer' as const } }]) {
+    let statusCode: number | undefined;
+    let body: unknown;
+    const res = {
+      status(code: number) {
+        statusCode = code;
+        return this;
+      },
+      json(value: unknown) {
+        body = value;
+        return this;
+      },
+    } as unknown as Response;
+
+    rbacMiddleware(['admin'])(req as AuthRequest, res, (() => {
+      assert.fail('next should not be called');
+    }) as NextFunction);
+
+    assert.equal(statusCode, 403);
+    assert.deepEqual(body, {
+      success: false,
+      message: 'Forbidden: insufficient permissions.',
+    });
+  }
+});
