diff --git a/scripts/google-sheets-csv.js b/scripts/google-sheets-csv.js
new file mode 100644
index 0000000..eef52ce
--- /dev/null
+++ b/scripts/google-sheets-csv.js
@@ -0,0 +1,82 @@
+const https = require('https');
+
+const GOOGLE_REDIRECT_HOST_SUFFIXES = [
+  '.google.com',
+  '.googleapis.com',
+  '.googleusercontent.com',
+];
+
+function fetchCSV(url) {
+  return new Promise((resolve, reject) => {
+    const parsedUrl = new URL(url);
+    const options = {
+      hostname: parsedUrl.hostname,
+      path: parsedUrl.pathname + parsedUrl.search,
+      headers: {
+        'User-Agent': 'Mozilla/5.0 (compatible; node.js)',
+      },
+    };
+
+    https.get(options, res => {
+      if ([301, 302, 303, 307, 308].includes(res.statusCode)) {
+        const location = res.headers.location;
+        const redirectUrl = /^https?:\/\//.test(location) ? location : new URL(location, url).href;
+        const redirectHost = new URL(redirectUrl).hostname;
+        if (!GOOGLE_REDIRECT_HOST_SUFFIXES.some(suffix => redirectHost.endsWith(suffix))) {
+          reject(new Error(`Unexpected redirect to ${redirectHost}`));
+          return;
+        }
+        fetchCSV(redirectUrl).then(resolve, reject);
+        return;
+      }
+      if (res.statusCode !== 200) {
+        reject(new Error(`Failed to fetch: ${res.statusCode}`));
+        return;
+      }
+
+      let data = '';
+      res.on('data', chunk => data += chunk);
+      res.on('end', () => resolve(data));
+    }).on('error', reject);
+  });
+}
+
+function parseCSV(csvText, {preserveEmptyRows = false} = {}) {
+  const rows = [];
+
+  for (const line of csvText.split(/\r?\n/)) {
+    if (!line.trim()) {
+      if (preserveEmptyRows) rows.push([]);
+      continue;
+    }
+
+    const fields = [];
+    let currentField = '';
+    let inQuotes = false;
+
+    for (let i = 0; i < line.length; i++) {
+      const char = line[i];
+      const nextChar = line[i + 1];
+
+      if (char === '"') {
+        if (inQuotes && nextChar === '"') {
+          currentField += '"';
+          i++;
+        } else {
+          inQuotes = !inQuotes;
+        }
+      } else if (char === ',' && !inQuotes) {
+        fields.push(currentField);
+        currentField = '';
+      } else {
+        currentField += char;
+      }
+    }
+    fields.push(currentField);
+    rows.push(fields);
+  }
+
+  return rows;
+}
+
+module.exports = {fetchCSV, parseCSV};
diff --git a/scripts/google-sheets-csv.test.js b/scripts/google-sheets-csv.test.js
new file mode 100644
index 0000000..15eb8b4
--- /dev/null
+++ b/scripts/google-sheets-csv.test.js
@@ -0,0 +1,21 @@
+const assert = require('assert');
+const {parseCSV} = require('./google-sheets-csv');
+
+const csv = 'Name,Description\r\n"Poké Ball","Useful, basic item"\r\n"Quote","Say ""hello"""\r\n\r\nLast,Row';
+
+assert.deepStrictEqual(parseCSV(csv), [
+  ['Name', 'Description'],
+  ['Poké Ball', 'Useful, basic item'],
+  ['Quote', 'Say "hello"'],
+  ['Last', 'Row'],
+]);
+
+assert.deepStrictEqual(parseCSV(csv, {preserveEmptyRows: true}), [
+  ['Name', 'Description'],
+  ['Poké Ball', 'Useful, basic item'],
+  ['Quote', 'Say "hello"'],
+  [],
+  ['Last', 'Row'],
+]);
+
+console.log('Google Sheets CSV utility tests passed.');
