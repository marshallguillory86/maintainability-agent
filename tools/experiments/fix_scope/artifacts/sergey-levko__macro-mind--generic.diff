+const DATE_SUFFIX = 'T12:00:00'
+
+/** Returns the local calendar date as YYYY-MM-DD. */
+export function localDateIso(date = new Date()): string {
+  const year = date.getFullYear()
+  const month = String(date.getMonth() + 1).padStart(2, '0')
+  const day = String(date.getDate()).padStart(2, '0')
+  return `${year}-${month}-${day}`
+}
+
+/** Parses a date-only value without allowing a UTC conversion to change its day. */
+export function parseLocalDate(iso: string): Date {
+  return new Date(iso + DATE_SUFFIX)
+}
+
+export function shiftDate(iso: string, days: number): string {
+  const date = parseLocalDate(iso)
+  date.setDate(date.getDate() + days)
+  return localDateIso(date)
+}
+
+export function formatMealLogDate(iso: string, today = localDateIso()): string {
+  const date = parseLocalDate(iso)
+  const dateLabel = date.toLocaleDateString('en-US', { month: 'long', day: 'numeric' })
+
+  if (iso === today) return `Today, ${dateLabel}`
+  if (iso === shiftDate(today, -1)) return `Yesterday, ${dateLabel}`
+
+  return date.toLocaleDateString('en-US', {
+    weekday: 'long',
+    month: 'long',
+    day: 'numeric',
+  })
+}
+
+export function localTimeHHMM(date = new Date()): string {
+  const hours = String(date.getHours()).padStart(2, '0')
+  const minutes = String(date.getMinutes()).padStart(2, '0')
+  return `${hours}:${minutes}`
+}
+
+export function isoDateTime(date: string, time: string): string {
+  return new Date(`${date}T${time}:00`).toISOString()
+}
