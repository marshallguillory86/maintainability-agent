 # ── Library of Congress API ───────────────────────────────────────
 
+def _parse_isbnsearch_markdown(markdown: str) -> dict:
+    """Parse the labeled fields returned by ISBNsearch's markdown page."""
+    result: dict = {}
+    for raw_line in markdown.splitlines():
+        match = re.match(r"\*?\*?([^:*]+)\*?\*?\s*:\s*(.+)", raw_line.strip())
+        if not match:
+            continue
+        label = match.group(1).strip().lower()
+        value = match.group(2).strip()
+        if label == "title" and not result.get("title"):
+            result["title"] = value
+        elif label in ("author", "authors") and not result.get("authors"):
+            result["authors"] = [
+                author.split(",")[0].strip()
+                for author in value.split(";") if author.strip()
+            ]
+        elif label == "publisher" and not result.get("publisher"):
+            result["publisher"] = value
+        elif label in ("published", "year") and not result.get("year"):
+            year = re.search(r"\b(\d{4})\b", value)
+            if year:
+                result["year"] = int(year.group(1))
+        elif label in ("isbn-13", "isbn13") and not result.get("isbn_13"):
+            clean = re.sub(r"[^\d]", "", value)
+            if len(clean) == 13:
+                result["isbn_13"] = clean
+        elif label in ("isbn-10", "isbn10") and not result.get("isbn_10"):
+            clean = re.sub(r"[^\d]", "", value)
+            if len(clean) == 10:
+                result["isbn_10"] = clean
+    return result
+
+
+def _fetch_isbnsearch(isbn: str) -> dict:
+    """Fetch ISBNsearch metadata via Firecrawl or direct HTML fallback."""
+    if not isbn:
+        return {}
+    url = f"https://isbnsearch.org/isbn/{isbn}"
+    if not _get_firecrawl_key():
+        return _fetch_isbnsearch_direct(isbn, url)
+    result = _parse_isbnsearch_markdown(_firecrawl_scrape(url))
+    if result:
+        log.info("ISBNsearch (Firecrawl): found %s (%s)",
+                 result.get("title", "?")[:40], result.get("year", "?"))
+    return result
+
