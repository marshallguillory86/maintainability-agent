diff --git a/tests/venue-application.test.ts b/tests/venue-application.test.ts
new file mode 100644
index 0000000..c9cdb78
--- /dev/null
+++ b/tests/venue-application.test.ts
@@ -0,0 +1,72 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import {
+  APPLICATION_AGREEMENTS,
+  applicationIdentity,
+  applicationInsert,
+  applicationValidationError,
+} from '../lib/venue-application.ts';
+
+const validBody = () => ({
+  email: ' Owner@Example.COM ',
+  firstName: ' Ada ',
+  venueName: ' Still Point ',
+  signedName: ' Ada Owner ',
+  agreements: Object.fromEntries(APPLICATION_AGREEMENTS.map((agreement) => [agreement, true])),
+});
+
+test('normalizes identity and accepts a complete application', () => {
+  const body = validBody();
+  const identity = applicationIdentity(body);
+
+  assert.deepEqual(identity, {
+    email: 'owner@example.com',
+    firstName: 'Ada',
+    venueName: 'Still Point',
+    signedName: 'Ada Owner',
+  });
+  assert.equal(applicationValidationError(body, identity), null);
+});
+
+test('returns the existing validation errors in priority order', () => {
+  const body = validBody();
+  assert.equal(
+    applicationValidationError({ ...body, email: 'bad' }, applicationIdentity({ ...body, email: 'bad' })),
+    'That does not look like an email address.',
+  );
+  const missingAgreement = { ...body, agreements: { ...body.agreements } };
+  delete missingAgreement.agreements[APPLICATION_AGREEMENTS[0]];
+  assert.equal(
+    applicationValidationError(missingAgreement, applicationIdentity(missingAgreement)),
+    'All five agreements have to be accepted.',
+  );
+});
+
+test('maps optional values to the database payload without changing defaults', () => {
+  const body = {
+    ...validBody(),
+    practiceCapacity: '12',
+    dailyCapacity: '',
+    whoMayAttend: ['Adults'],
+    culturalProtocols: [],
+    currentlyOffering: false,
+    confirmedAccurate: 1,
+  };
+  const insert = applicationInsert(
+    body,
+    applicationIdentity(body),
+    '203.0.113.1',
+    'https://example.com/apply',
+    '2026-08-08',
+  );
+
+  assert.equal(insert.practice_space_capacity, 12);
+  assert.equal(insert.daily_guest_capacity, null);
+  assert.deepEqual(insert.who_may_attend, ['Adults']);
+  assert.equal(insert.cultural_protocols, null);
+  assert.equal(insert.currently_offering, false);
+  assert.equal(insert.price_currency, 'AUD');
+  assert.equal(insert.signed_on, '2026-08-08');
+  assert.equal(insert.submitted_ip, '203.0.113.1');
+  assert.equal(insert.confirmed_accurate, true);
+});
