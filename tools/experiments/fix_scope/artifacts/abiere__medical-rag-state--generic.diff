@@ -0,0 +1,70 @@
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from scripts import nightly_stats
+
+
+class NightlyStatsTests(unittest.TestCase):
+    def setUp(self):
+        self.temp_dir = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp_dir.cleanup)
+        self.stats_path = Path(self.temp_dir.name) / "nested" / "nightly_stats.json"
+        self.path_patch = patch.object(nightly_stats, "STATS_PATH", self.stats_path)
+        self.path_patch.start()
+        self.addCleanup(self.path_patch.stop)
+
+    def test_load_stats_returns_independent_defaults_for_invalid_json(self):
+        self.stats_path.parent.mkdir(parents=True)
+        self.stats_path.write_text("not json")
+
+        first = nightly_stats.load_stats()
+        first["retroaudit"]["samples"].append({"unexpected": True})
+
+        self.assertEqual(nightly_stats.load_stats()["retroaudit"]["samples"], [])
+
+    def test_load_stats_fills_missing_phase_defaults(self):
+        self.stats_path.parent.mkdir(parents=True)
+        self.stats_path.write_text(json.dumps({"retroaudit": {"n_samples": 4}}))
+
+        stats = nightly_stats.load_stats()
+
+        self.assertEqual(stats["retroaudit"]["n_samples"], 4)
+        self.assertIn("image_screening", stats)
+        self.assertEqual(stats["image_screening"]["avg_sec_per_image"], 8.0)
+
+    def test_recorders_share_persistence_and_rate_calculation(self):
+        nightly_stats.record_retroaudit(4, 10.0)
+        nightly_stats.record_image_screening(2, 5.0)
+
+        stats = json.loads(self.stats_path.read_text())
+        self.assertEqual(stats["retroaudit"]["samples"][0]["sec_per_chunk"], 2.5)
+        self.assertEqual(stats["image_screening"]["samples"][0]["sec_per_image"], 2.5)
+        self.assertEqual(stats["retroaudit"]["n_samples"], 1)
+        self.assertEqual(stats["image_screening"]["n_samples"], 1)
+
+    def test_recording_keeps_only_the_latest_thirty_samples(self):
+        for count in range(1, 33):
+            nightly_stats.record_retroaudit(count, float(count))
+
+        samples = nightly_stats.load_stats()["retroaudit"]["samples"]
+        self.assertEqual(len(samples), 30)
+        self.assertEqual(samples[0]["chunks"], 3)
+        self.assertEqual(samples[-1]["chunks"], 32)
+
+    def test_allocate_window_reserves_fifteen_minutes(self):
+        allocation = nightly_stats.allocate_window(
+            window_seconds=1800,
+            n_chunks_skipped=0,
+            n_images_pending=5,
+            claude_api_enabled=False,
+        )
+
+        self.assertEqual(allocation["retroaudit_seconds"], 0)
+        self.assertEqual(allocation["image_seconds"], 900)
+
+
+if __name__ == "__main__":
+    unittest.main()
