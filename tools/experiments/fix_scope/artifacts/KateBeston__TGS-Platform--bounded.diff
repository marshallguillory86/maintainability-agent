diff --git a/lib/venue-application.ts b/lib/venue-application.ts
new file mode 100644
index 0000000..00b8611
--- /dev/null
+++ b/lib/venue-application.ts
@@ -0,0 +1,132 @@
+export const APPLICATION_AGREEMENTS = [
+  'website-terms-of-use',
+  'venue-owner-agreement',
+  'concierge-introduction-terms',
+  'venue-data-accuracy-declaration',
+  'health-safety-liability-declaration',
+] as const;
+
+export type ApplicationBody = Record<string, any>;
+
+export interface ApplicationIdentity {
+  email: string;
+  firstName: string;
+  venueName: string;
+  signedName: string;
+}
+
+export function applicationIdentity(body: ApplicationBody): ApplicationIdentity {
+  return {
+    email: String(body.email ?? '').trim().toLowerCase(),
+    firstName: String(body.firstName ?? '').trim(),
+    venueName: String(body.venueName ?? '').trim(),
+    signedName: String(body.signedName ?? '').trim(),
+  };
+}
+
+export function applicationValidationError(
+  body: ApplicationBody,
+  identity: ApplicationIdentity,
+): string | null {
+  if (!identity.email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(identity.email)) {
+    return 'That does not look like an email address.';
+  }
+  if (!identity.firstName || !identity.venueName) {
+    return 'A name and the venue name, at minimum.';
+  }
+  if (!body.agreements || APPLICATION_AGREEMENTS.some((agreement) => !body.agreements[agreement])) {
+    return 'All five agreements have to be accepted.';
+  }
+  if (!identity.signedName) {
+    return 'A signature — your full name.';
+  }
+  return null;
+}
+
+const optionalNumber = (value: any) =>
+  value === '' || value === null || value === undefined ? null : Number(value);
+const optionalArray = (value: any) => Array.isArray(value) && value.length ? value : null;
+
+function contactFields(body: ApplicationBody, identity: ApplicationIdentity) {
+  return {
+    salutation: body.salutation || null,
+    first_name: identity.firstName,
+    surname: body.surname || null,
+    email: identity.email,
+    phone: body.phone || null,
+    role: body.role || null,
+    business_name: body.businessName || null,
+    business_address: body.businessAddress || null,
+    abn: body.abn || null,
+  };
+}
+
+function venueFields(body: ApplicationBody, identity: ApplicationIdentity) {
+  return {
+    venue_name: identity.venueName,
+    location_text: body.location || null,
+    website_url: body.venueWebsite || null,
+    instagram_url: body.instagram || null,
+    facebook_url: body.facebook || null,
+    venue_type_other: body.venueTypeOther || null,
+    marketplace: body.marketplace || null,
+    practice_space_capacity: optionalNumber(body.practiceCapacity),
+    daily_guest_capacity: optionalNumber(body.dailyCapacity),
+    accommodation_capacity: optionalNumber(body.accommodationCapacity),
+    total_bedrooms: optionalNumber(body.bedrooms),
+    ensuites: optionalNumber(body.ensuites),
+    shared_bathrooms: optionalNumber(body.sharedBathrooms),
+  };
+}
+
+function commercialFields(body: ApplicationBody) {
+  return {
+    price_from: optionalNumber(body.priceFrom),
+    price_currency: body.priceCurrency || 'AUD',
+    price_basis: body.priceBasis || null,
+    price_includes: body.priceIncludes || null,
+    who_may_attend: optionalArray(body.whoMayAttend),
+    who_may_attend_other: body.whoMayAttendOther || null,
+    orientation: body.orientation || null,
+    cultural_protocols: optionalArray(body.culturalProtocols),
+    protocols_stated_where: body.protocolsWhere || null,
+    hosting_notes: body.hostingNotes || null,
+  };
+}
+
+function facilityFields(body: ApplicationBody) {
+  return {
+    space_type_names: optionalArray(body.spaceTypes),
+    service_names: optionalArray(body.services),
+    bed_configuration: optionalArray(body.bedConfiguration),
+    accommodation_features: optionalArray(body.accommodationFeatures),
+    amenity_names: optionalArray(body.amenities),
+    other_amenities: body.otherAmenities || null,
+    experience_format: body.experienceFormat || null,
+    currently_offering: body.currentlyOffering ?? null,
+  };
+}
+
+export function applicationInsert(
+  body: ApplicationBody,
+  identity: ApplicationIdentity,
+  submittedIp: string | null,
+  submittedFrom: string | null,
+  today = new Date().toISOString().slice(0, 10),
+) {
+  return {
+    ...contactFields(body, identity),
+    ...venueFields(body, identity),
+    ...commercialFields(body),
+    ...facilityFields(body),
+    message: body.message || null,
+    heard_about: body.heardAbout || null,
+    signed_name: identity.signedName,
+    signed_on: body.signedOn || today,
+    confirmed_accurate: !!body.confirmedAccurate,
+    wants_journal: !!body.wantsJournal,
+    submitted_ip: submittedIp,
+    submitted_from: submittedFrom,
+    utm: body.utm ?? null,
+  };
+}
