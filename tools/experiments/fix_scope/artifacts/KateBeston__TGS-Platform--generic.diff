diff --git a/lib/form-values.ts b/lib/form-values.ts
new file mode 100644
index 0000000..5fce039
--- /dev/null
+++ b/lib/form-values.ts
@@ -0,0 +1,30 @@
+const EMAIL_PATTERN = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
+
+/** Convert an untrusted form value to the trimmed text the API stores. */
+export function formText(value: unknown): string {
+  return String(value ?? '').trim();
+}
+
+/** Return null for blank optional fields, matching the database schema. */
+export function optionalFormText(value: unknown): string | null {
+  return formText(value) || null;
+}
+
+export function formEmail(value: unknown): string {
+  return formText(value).toLowerCase();
+}
+
+export function isValidEmail(value: string): boolean {
+  return EMAIL_PATTERN.test(value);
+}
+
+/** Calculate a positive whole-day stay, or null for incomplete/invalid dates. */
+export function stayLength(dateFrom: unknown, dateTo: unknown): number | null {
+  const from = Date.parse(formText(dateFrom));
+  const to = Date.parse(formText(dateTo));
+
+  if (!Number.isFinite(from) || !Number.isFinite(to)) return null;
+
+  const nights = Math.round((to - from) / 86_400_000);
+  return nights > 0 ? nights : null;
+}
