{
  "version": 1,
  "analyzers": {
    "_doc": "Which external analyzers may run. See docs/analyzer-pool.md. Resolve with: python tools/resolve_pool.py",
    "concerns": [
      "all"
    ],
    "depth": "moderate",
    "license_policy": "permissive",
    "prompt_when_interactive": true,
    "allow_tools": [],
    "deny_tools": [],
    "deny_license_classes": [],
    "deny_concerns": [
      "security"
    ],
    "timeout_seconds": 120
  },
  "paths": {
    "include_extensions": [
      ".py",
      ".md",
      ".json",
      ".yml",
      ".yaml"
    ],
    "exclude_patterns": [
      ".git/",
      ".venv/",
      "__pycache__/",
      "node_modules/",
      "htmlcov/",
      "*.egg-info/",
      "dist/",
      "build/",
      ".pytest_cache/",
      "examples/reports/",
      "tools/validation/reports/",
      "maintainability-report.md",
      "maintainability-remediation-prompt.md",
      "maintainability-pr-comment.md",
      "maintainability-baseline.json",
      "maintainability.sarif",
      "coverage.xml",
      "AGENTS-maintainability.md",
      "tools/calibration/*.json",
      "tools/validation/*.json",
      "tools/experiments/*/results.json",
      "tests/fixtures/*.json",
      "tests/fixtures/*/*.json",
      "tests/fixtures/*.java",
      "tests/fixtures/*/*.java",
      "data/analyzer-catalog.json"
    ]
  },
  "thresholds": {
    "max_file_lines": 500,
    "warn_file_lines": 250,
    "max_function_lines": 80,
    "warn_function_lines": 60,
    "max_complexity": 15,
    "warn_complexity": 12,
    "max_duplicate_blocks": 0,
    "duplicate_block_lines": 14
  },
  "hard_gates": {
    "require_test_command": true,
    "require_readme": true,
    "require_clean_worktree": false,
    "fail_on_file_failures": true,
    "fail_on_function_failures": true,
    "fail_on_duplicate_blocks": true
  },
  "expected_files": [
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "maintainability-agent.schema.json",
    "docs/cli.md",
    "docs/philosophy.md"
  ],
  "expected_commands": {
    "test": [
      "PYTHONPATH=src python3 -m pytest --cov=maintainability_audit --cov-report=term-missing --cov-report=xml:coverage.xml --cov-fail-under=92"
    ],
    "lint": [
      "python3 -m py_compile src/maintainability_audit/*.py"
    ]
  },
  "risk_patterns": [
    {
      "name": "dynamic-code-execution",
      "pattern": "\\b(eval|exec)\\s*\\(",
      "extensions": [
        ".py",
        ".js",
        ".jsx",
        ".mjs",
        ".cjs",
        ".ts",
        ".tsx"
      ]
    }
  ],
  "instruction_pack": {
    "project_name": "Maintainability Agent",
    "strictness": "high",
    "test_policy": "pytest for CLI behavior plus self-audit before release",
    "architecture_notes": [
      "Keep deterministic analysis separate from AI prompt generation.",
      "Do not call LLMs or external services by default.",
      "Prefer small adapter functions over a monolithic scanner."
    ]
  }
}
