+++ b/src/components/addWizardLogic.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, it } from "vitest";
+import type { AddDraft } from "../types";
+import { buildPlaceData, canAdvance, isRampType } from "./addWizardLogic";
+
+const draft: AddDraft = {
+  photoFile: null,
+  photoUrl: null,
+  name: "",
+  category: "food",
+  lat: null,
+  lng: null,
+  status: "",
+  stepsCount: "",
+  stepHeightCm: "",
+  rampType: "none",
+  doorWidthCm: "",
+  entranceNotes: "",
+  toiletExists: "unknown",
+  toiletAccessible: "unknown",
+  comment: "",
+};
+
+describe("add wizard rules", () => {
+  it("describes the requirements for each step", () => {
+    expect(canAdvance(1, draft)).toBe(false);
+    expect(canAdvance(1, { ...draft, photoUrl: "preview", lat: 43 })).toBe(true);
+    expect(canAdvance(2, draft)).toBe(false);
+    expect(canAdvance(2, { ...draft, name: "Кафе" })).toBe(true);
+    expect(canAdvance(3, draft)).toBe(false);
+    expect(canAdvance(3, { ...draft, status: "green" })).toBe(true);
+    expect(canAdvance(4, draft)).toBe(true);
+  });
+
+  it("converts form strings into the create-place payload", () => {
+    expect(buildPlaceData({
+      ...draft,
+      name: "Кафе",
+      status: "yellow",
+      stepsCount: "2",
+      stepHeightCm: "15",
+      doorWidthCm: "90",
+    })).toMatchObject({
+      name: "Кафе",
+      lat: 43.0033,
+      lng: 41.0237,
+      status: "yellow",
+      stepsCount: 2,
+      stepHeightCm: 15,
+      doorWidthCm: 90,
+      source: "operator",
+    });
+  });
+
+  it("accepts only supported ramp values", () => {
+    expect(isRampType("portable_available")).toBe(true);
+    expect(isRampType("temporary")).toBe(false);
+  });
+});
diff --git a/src/components/addWizardLogic.ts b/src/components/addWizardLogic.ts
new file mode 100644
index 0000000..8d1fd38
--- /dev/null
+++ b/src/components/addWizardLogic.ts
@@ -0,0 +1,45 @@
+import type { AccessibilityStatus, AddDraft, Place } from "../types";
+
+export type WizardStep = 1 | 2 | 3 | 4;
+
+const DEFAULT_LOCATION = { lat: 43.0033, lng: 41.0237 } as const;
+
+export function canAdvance(step: WizardStep, draft: AddDraft): boolean {
+  switch (step) {
+    case 1:
+      return Boolean(draft.photoUrl && draft.lat);
+    case 2:
+      return Boolean(draft.name && draft.category);
+    case 3:
+      return Boolean(draft.status);
+    case 4:
+      return true;
+  }
+}
+
+export function isRampType(value: string): value is AddDraft["rampType"] {
+  return ["none", "permanent", "portable_on_request", "portable_available"].includes(value);
+}
+
+function optionalInteger(value: string): number | null {
+  return value ? Number.parseInt(value, 10) : null;
+}
+
+export function buildPlaceData(draft: AddDraft): Partial<Place> {
+  return {
+    name: draft.name,
+    category: draft.category,
+    lat: draft.lat || DEFAULT_LOCATION.lat,
+    lng: draft.lng || DEFAULT_LOCATION.lng,
+    status: draft.status as AccessibilityStatus,
+    stepsCount: optionalInteger(draft.stepsCount),
+    stepHeightCm: optionalInteger(draft.stepHeightCm),
+    rampType: draft.rampType,
+    doorWidthCm: optionalInteger(draft.doorWidthCm),
+    entranceNotes: draft.entranceNotes,
+    toiletExists: draft.toiletExists,
+    toiletAccessible: draft.toiletAccessible,
+    comment: draft.comment,
+    source: "operator",
+  };
+}
